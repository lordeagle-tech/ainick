    "axios": "1.7.9",
    "dotenv": "16.4.7",
    "ffmpeg-static": "5.2.0",
    "form-data": "4.0.1",
    "jiti": "^2.7.0",
    "libsignal": "6.0.0",
    "mathjs": "14.0.1",
    "msedge-tts": "1.3.4",
    "pino": "9.6.0",
    "playwright": "1.49.1",
    "playwright-core": "1.49.1",
    "puppeteer": "25.3.0",
    "puppeteer-core": "25.3.0",
    "qrcode-terminal": "0.12.0",
    "sharp": "0.33.5",
