# Nick AI — copy to .env and fill in your private values.
# Never publish .env, sessions/, or data/ to GitHub.

# Groq Console API key (required for AI replies)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Optional fallback model (defaults to GROQ_MODEL if unset)
# GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
AI_DEFAULT_PROVIDER=groq

# Comma-separated owner phone numbers in international format, digits only.
# Main owner:
OWNER_IDS=your_owner_number

# Terminal log verbosity: fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL=info

# Terminal-only WhatsApp pairing: npm start prompts for the phone number and displays a pairing code.
# Optional: set this to skip the startup prompt. Otherwise, npm start asks for it.
# WHATSAPP_PAIRING_NUMBER=14155552671

# Nick AI defaults and context window tuning
PERSONA_DEFAULT=nick
MEMORY_MAX_TURNS=240
MEMORY_PROMPT_TURNS=100
MEMORY_STALE_MS=7776000000

# Optional: shorten or lengthen AI HTTP timeout (milliseconds)
AI_HTTP_TIMEOUT_MS=300000

# Optional systemd controls, disabled until exact units are allowlisted.
# Example only: VPS_ALLOWED_SERVICES=nginx.service,myapp.service
VPS_ALLOWED_SERVICES=

# Optional Checker Tools integrations. Subdomain lookup uses public certificate-transparency data.
# YouTube Data API key for public channel statistics and subscriber-threshold checks.
YOUTUBE_API_KEY=
# Sapling AI-text detector API key.
SAPLING_API_KEY=
# OpenAI moderation API key for text/image NSFW checks.
OPENAI_MODERATION_API_KEY=
